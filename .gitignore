# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# test / example artifacts (regenerated by `pnpm test` and `pnpm examples`)
packages/*/tests/__fixtures__/out/
examples/*/out/
coverage/
*.tgz

# tooling logs (written only when a command fails; must never be committed)
*.log
.pnpm-debug.log*
npm-debug.log*

# tooling caches
.eslintcache
.size-limit.json.cache
.turbo/
.vitest/

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# local env
.env
.env.*
!.env.example
