exports[`parseMarkdown: fixtures > 20-emphasis-edge-cases.md > outline 1`] = `
"p "Intraword underscores stay literal: snake_case_name and " <bold>"dunder__init" "."
p "Intraword asterisks do emphasise: aster" <italic>"isk" "s."
p "Triple markers: " <bold+italic>"bold italic" ", and " <bold+italic>"also bold italic" "."
p "Mixed nesting: " <bold>"bold with " <bold+italic>"italic" <bold>" inside" ", and " <italic>"italic with " <bold+italic>"bold" <italic>" inside" "."
p "Overlapping (not nestable): " <italic>"a " <italic>"b" <italic>" c" "."
p "Adjacent runs: " <bold>"a****b" " and " <italic>"a**b" "."
p "Emphasis touching punctuation: " <bold>"\\"quoted\\"" ", " <italic>"(parenthesised)" ", " <bold>"end."
p "Emphasis around a link: " <link:https://example.com+bold>"bold link" " and" <NL> <link:https://example.com+italic>"italic link text" "."
p "Strikethrough combined: " <bold+strikethrough>"struck bold" " and " <bold+strikethrough>"bold struck" "."
p "An unmatched marker: **not closed"
p "A single asterisk on its own: *"
p "Emphasis with an underscore inside a word boundary: " <italic>"leading" " and trailing_.""
`;

