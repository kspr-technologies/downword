"list ordered start=1 loose
  item
    p "Top level ordered"
    list bullet loose
      item
        p "Second level bullet"
        list ordered start=1 tight
          item
            p "Third level ordered"
            list bullet tight
              item
                p "Fourth level bullet"
                list ordered start=1 tight
                  item
                    p "Fifth level ordered"
                    list bullet tight
                      item
                        p "Sixth level bullet, which Word cannot indent any further"
              item
                p "Another fourth level bullet"
          item
            p "Back to third level"
      item
        p "Another second level bullet"
        p "With a second paragraph, which makes this list loose."
  item
    p "Second top-level item"
    list ordered start=1 tight
      item
        p "Nested ordered under ordered"
        list ordered start=1 tight
          item
            p "And again"
      item
        p "Sibling"
list bullet tight
  item
    p "Bullet at top level"
    list ordered start=1 tight
      item
        p "Ordered inside a bullet"
