exports[`parseMarkdown: fixtures > 28-chatgpt-migration-answer.md > outline 1`] = `
"p "Great question! Migrating from " <bold>"Postgres 12" " to " <bold>"Postgres 16" " is mostly" <NL> "mechanical, but there are three or four places where people get burned. Here's" <NL> "how I'd approach it."
h2 #tldr "TL;DR"
list bullet tight
  item
    p "Use " <inlineCode>"pg_upgrade --link" " if you can afford the downtime — it's ~10x faster."
  item
    p <bold>"Do not" " skip the " <inlineCode>"ANALYZE" " afterwards; the planner will be blind until you do."
  item
    p "Watch out for the " <inlineCode>"standard_conforming_strings" " change if you're coming from" <NL> "a " <italic>"very" " old dump."
hr
h2 #1-pre-flight-checks "1. Pre-flight checks"
p "First, confirm the extensions you actually use:"
code lang=sql "SELECT extname, extversion FROM pg_extension ORDER BY extname;\\n"
p "Then check for anything deprecated:"
table align=[none,center,center,none]
  row header
    cell "Extension"
    cell "PG 12"
    cell "PG 16"
    cell "Action"
  row
    cell <inlineCode>"postgis"
    cell "3.0"
    cell "3.4"
    cell "Upgrade " <bold>"before" " the server upgrade"
  row
    cell <inlineCode>"pg_stat_statements"
    cell "✅"
    cell "✅"
    cell "No action"
  row
    cell <inlineCode>"chkpass"
    cell "✅"
    cell "❌"
    cell <bold>"Removed" " — migrate to " <inlineCode>"pgcrypto"
  row
    cell <inlineCode>"adminpack"
    cell "✅"
    cell "❌"
    cell "Drop it; nothing uses it"
quote
  p "⚠️ " <bold>"Important:" " if " <inlineCode>"chkpass" " is in use, the upgrade will " <italic>"abort" " with" <NL> <inlineCode>"could not load library" ". Check first."
h2 #2-the-upgrade-itself "2. The upgrade itself"
list ordered start=1 loose
  item
    p "Stop the old cluster:"
    code lang=bash "sudo systemctl stop postgresql@12-main\\n"
  item
    p "Run the compatibility check (this does " <bold>"not" " modify anything):"
    code lang=bash "/usr/lib/postgresql/16/bin/pg_upgrade \\\\\\n  --old-datadir=/var/lib/postgresql/12/main \\\\\\n  --new-datadir=/var/lib/postgresql/16/main \\\\\\n  --old-bindir=/usr/lib/postgresql/12/bin \\\\\\n  --new-bindir=/usr/lib/postgresql/16/bin \\\\\\n  --check\\n"
  item
    p "If that passes, drop the " <inlineCode>"--check" " and run it for real. With " <inlineCode>"--link" ":"
    code lang=bash "... --link\\n"
    quote
      p <bold>"Note:" " " <inlineCode>"--link" " hard-links the data files, so " <bold>"the old cluster becomes" <bold><NL> <bold>"unusable" ". Take a backup you can actually restore from first."
  item
    p "Rebuild statistics — this is the step everyone forgets:"
    code lang=bash "/usr/lib/postgresql/16/bin/vacuumdb --all --analyze-in-stages\\n"
h2 #3-things-that-changed-and-will-bite-you "3. Things that changed and will bite you"
list task tight
  item [x]
    p <inlineCode>"pg_dump" " now emits " <inlineCode>"SET transaction_timeout" " — harmless, but it breaks" <NL> "naive " <inlineCode>"grep" "-based dump diffing."
  item [x]
    p "The default " <inlineCode>"password_encryption" " is " <inlineCode>"scram-sha-256" ". Old clients" <NL> "(" <inlineCode>"libpq" " < 10, JDBC < 42.2) " <bold>"cannot connect" "."
  item [ ]
    p <inlineCode>"LOGICAL" " replication slots do " <italic>"not" " survive " <inlineCode>"pg_upgrade" ". Recreate them."
  item [ ]
    p <inlineCode>"SEARCH_PATH" " handling in " <inlineCode>"SECURITY DEFINER" " functions is stricter."
h3 #client-compatibility "Client compatibility"
p "If you see this:"
code lang=- "FATAL:  password authentication failed for user \\"app\\"\\nDETAIL:  User \\"app\\" does not have a valid SCRAM secret.\\n"
p "...it means the stored hash is still MD5. Fix it with:"
code lang=sql "ALTER SYSTEM SET password_encryption = 'scram-sha-256';\\nSELECT pg_reload_conf();\\n-- then, per user:\\n\\\\password app\\n"
h2 #4-rollback-plan "4. Rollback plan"
table align=[none,none,right]
  row header
    cell "Scenario"
    cell "Recovery"
    cell "RTO"
  row
    cell <inlineCode>"--check" " fails"
    cell "Nothing to undo"
    cell "0"
  row
    cell "Upgrade fails mid-way, no " <inlineCode>"--link"
    cell "Start the old cluster"
    cell "~1 min"
  row
    cell "Upgrade fails mid-way, with " <inlineCode>"--link"
    cell "Restore from backup"
    cell "~45 min"
hr
p <bold>"Let me know" " which Postgres distribution you're on (Debian packages? RDS?" <NL> "Docker?) and I can tailor the commands — RDS in particular does " <italic>"none" " of this" <NL> "the same way.""
`;

