          "type": "paragraph",
        },
      ],
      "type": "blockquote",
    },
    {
      "children": [
        {
          "marks": [],
          "type": "text",
          "value": "2. The upgrade itself",
        },
      ],
      "id": "2-the-upgrade-itself",
      "level": 2,
      "type": "heading",
    },
    {
      "children": [
        {
          "checked": null,
          "children": [
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Stop the old cluster:",
                },
              ],
              "type": "paragraph",
            },
            {
              "highlights": null,
              "lang": "bash",
              "meta": null,
              "type": "codeBlock",
              "value": "sudo systemctl stop postgresql@12-main
",
            },
          ],
          "type": "listItem",
        },
        {
          "checked": null,
          "children": [
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Run the compatibility check (this does ",
                },
                {
                  "marks": [
                    {
                      "type": "bold",
                    },
                  ],
                  "type": "text",
                  "value": "not",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " modify anything):",
                },
              ],
              "type": "paragraph",
            },
            {
              "highlights": null,
              "lang": "bash",
              "meta": null,
              "type": "codeBlock",
              "value": "/usr/lib/postgresql/16/bin/pg_upgrade \\
  --old-datadir=/var/lib/postgresql/12/main \\
  --new-datadir=/var/lib/postgresql/16/main \\
  --old-bindir=/usr/lib/postgresql/12/bin \\
  --new-bindir=/usr/lib/postgresql/16/bin \\
  --check
",
            },
          ],
          "type": "listItem",
        },
        {
          "checked": null,
          "children": [
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "If that passes, drop the ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "--check",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " and run it for real. With ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "--link",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": ":",
                },
              ],
              "type": "paragraph",
            },
            {
              "highlights": null,
              "lang": "bash",
              "meta": null,
              "type": "codeBlock",
              "value": "... --link
",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "marks": [
                        {
                          "type": "bold",
                        },
                      ],
                      "type": "text",
                      "value": "Note:",
                    },
                    {
                      "marks": [],
                      "type": "text",
                      "value": " ",
                    },
                    {
                      "marks": [
                        {
                          "type": "inlineCode",
                        },
                      ],
                      "type": "text",
                      "value": "--link",
                    },
                    {
                      "marks": [],
                      "type": "text",
                      "value": " hard-links the data files, so ",
                    },
                    {
                      "marks": [
                        {
                          "type": "bold",
                        },
                      ],
                      "type": "text",
                      "value": "the old cluster becomes",
                    },
                    {
                      "marks": [
                        {
                          "type": "bold",
                        },
                      ],
                      "type": "softBreak",
                    },
                    {
                      "marks": [
                        {
                          "type": "bold",
                        },
                      ],
                      "type": "text",
                      "value": "unusable",
                    },
                    {
                      "marks": [],
                      "type": "text",
                      "value": ". Take a backup you can actually restore from first.",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "type": "blockquote",
            },
          ],
          "type": "listItem",
        },
        {
          "checked": null,
          "children": [
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Rebuild statistics — this is the step everyone forgets:",
                },
              ],
              "type": "paragraph",
            },
            {
              "highlights": null,
              "lang": "bash",
              "meta": null,
              "type": "codeBlock",
              "value": "/usr/lib/postgresql/16/bin/vacuumdb --all --analyze-in-stages
",
            },
          ],
          "type": "listItem",
        },
      ],
      "kind": "ordered",
      "start": 1,
      "tight": false,
      "type": "list",
    },
    {
      "children": [
        {
          "marks": [],
          "type": "text",
          "value": "3. Things that changed and will bite you",
        },
      ],
      "id": "3-things-that-changed-and-will-bite-you",
      "level": 2,
      "type": "heading",
    },
    {
      "children": [
        {
          "checked": true,
          "children": [
            {
              "children": [
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "pg_dump",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " now emits ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "SET transaction_timeout",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " — harmless, but it breaks",
                },
                {
                  "marks": [],
                  "type": "softBreak",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": "naive ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "grep",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": "-based dump diffing.",
                },
              ],
              "type": "paragraph",
            },
          ],
          "type": "listItem",
        },
        {
          "checked": true,
          "children": [
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "The default ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "password_encryption",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " is ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "scram-sha-256",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": ". Old clients",
                },
                {
                  "marks": [],
                  "type": "softBreak",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": "(",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "libpq",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " < 10, JDBC < 42.2) ",
                },
                {
                  "marks": [
                    {
                      "type": "bold",
                    },
                  ],
                  "type": "text",
                  "value": "cannot connect",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": ".",
                },
              ],
              "type": "paragraph",
            },
          ],
          "type": "listItem",
        },
        {
          "checked": false,
          "children": [
            {
              "children": [
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "LOGICAL",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " replication slots do ",
                },
                {
                  "marks": [
                    {
                      "type": "italic",
                    },
                  ],
                  "type": "text",
                  "value": "not",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " survive ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "pg_upgrade",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": ". Recreate them.",
                },
              ],
              "type": "paragraph",
            },
          ],
          "type": "listItem",
        },
        {
          "checked": false,
          "children": [
            {
              "children": [
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "SEARCH_PATH",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " handling in ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "SECURITY DEFINER",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " functions is stricter.",
                },
              ],
              "type": "paragraph",
            },
          ],
          "type": "listItem",
        },
      ],
      "kind": "task",
      "start": null,
      "tight": true,
      "type": "list",
    },
    {
      "children": [
        {
          "marks": [],
          "type": "text",
          "value": "Client compatibility",
        },
      ],
      "id": "client-compatibility",
      "level": 3,
      "type": "heading",
    },
    {
      "children": [
        {
          "marks": [],
          "type": "text",
          "value": "If you see this:",
        },
      ],
      "type": "paragraph",
    },
    {
      "highlights": null,
      "lang": null,
      "meta": null,
      "type": "codeBlock",
      "value": "FATAL:  password authentication failed for user "app"
DETAIL:  User "app" does not have a valid SCRAM secret.
",
    },
    {
      "children": [
        {
          "marks": [],
          "type": "text",
          "value": "...it means the stored hash is still MD5. Fix it with:",
        },
      ],
      "type": "paragraph",
    },
    {
      "highlights": null,
      "lang": "sql",
      "meta": null,
      "type": "codeBlock",
      "value": "ALTER SYSTEM SET password_encryption = 'scram-sha-256';
SELECT pg_reload_conf();
-- then, per user:
\\password app
",
    },
    {
      "children": [
        {
          "marks": [],
          "type": "text",
          "value": "4. Rollback plan",
        },
      ],
      "id": "4-rollback-plan",
      "level": 2,
      "type": "heading",
    },
    {
      "align": [
        "none",
        "none",
        "right",
      ],
      "children": [
        {
          "children": [
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Scenario",
                },
              ],
              "type": "tableCell",
            },
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Recovery",
                },
              ],
              "type": "tableCell",
            },
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "RTO",
                },
              ],
              "type": "tableCell",
            },
          ],
          "header": true,
          "type": "tableRow",
        },
        {
          "children": [
            {
              "children": [
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "--check",
                },
                {
                  "marks": [],
                  "type": "text",
                  "value": " fails",
                },
              ],
              "type": "tableCell",
            },
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Nothing to undo",
                },
              ],
              "type": "tableCell",
            },
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "0",
                },
              ],
              "type": "tableCell",
            },
          ],
          "header": false,
          "type": "tableRow",
        },
        {
          "children": [
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Upgrade fails mid-way, no ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "--link",
                },
              ],
              "type": "tableCell",
            },
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Start the old cluster",
                },
              ],
              "type": "tableCell",
            },
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "~1 min",
                },
              ],
              "type": "tableCell",
            },
          ],
          "header": false,
          "type": "tableRow",
        },
        {
          "children": [
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Upgrade fails mid-way, with ",
                },
                {
                  "marks": [
                    {
                      "type": "inlineCode",
                    },
                  ],
                  "type": "text",
                  "value": "--link",
                },
              ],
              "type": "tableCell",
            },
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "Restore from backup",
                },
              ],
              "type": "tableCell",
            },
            {
              "children": [
                {
                  "marks": [],
                  "type": "text",
                  "value": "~45 min",
                },
              ],
              "type": "tableCell",
            },
          ],
          "header": false,
          "type": "tableRow",
        },
      ],
      "type": "table",
    },
    {
      "type": "thematicBreak",
    },
    {
      "children": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "type": "text",
          "value": "Let me know",
        },
        {
          "marks": [],
          "type": "text",
          "value": " which Postgres distribution you're on (Debian packages? RDS?",
        },
        {
          "marks": [],
          "type": "softBreak",
        },
        {
          "marks": [],
          "type": "text",
          "value": "Docker?) and I can tailor the commands — RDS in particular does ",
        },
        {
          "marks": [
            {
              "type": "italic",
