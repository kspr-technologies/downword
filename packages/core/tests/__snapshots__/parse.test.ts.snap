exports[`parseMarkdown: fixtures > 05-ordered-list-with-fenced-code.md > outline 1`] = `
"p "Here's how to set it up:"
list ordered start=1 loose
  item
    p "Install the dependencies:"
    code lang=bash "npm install express cors\\n"
  item
    p "Create a " <inlineCode>"server.js" " file:"
    code lang=js "const express = require(\\"express\\");\\nconst app = express();\\n\\napp.get(\\"/\\", (req, res) => {\\n  res.json({ ok: true });\\n});\\n\\napp.listen(3000);\\n"
  item
    p "Run it:"
    code lang=- "node server.js\\n"
    p "You should see the server start on port 3000."
  item
    p "Verify with " <inlineCode>"curl" ":"
    code lang=bash "curl -s localhost:3000 | jq .\\n"
    quote
      p <bold>"Note:" " if " <inlineCode>"jq" " isn't installed, drop the pipe."
p "That's it! Let me know if you hit any errors.""
`;

