exports[`parseMarkdown: fixtures > 18-links-autolinks-references.md > outline 1`] = `
"p "An inline link: " <link:https://example.com/docs>"the docs" "."
p "An inline link with a title: " <link:https://example.com/docs title="Read this first">"the docs" "."
p "An autolink: " <link:https://example.com/auto>"https://example.com/auto" " and an e-mail autolink" <NL> <link:mailto:hello@example.com>"hello@example.com" "."
p "A bare URL that linkify picks up: " <link:https://bare.example.com/path?x=1#frag>"https://bare.example.com/path?x=1#frag"
p "A bare e-mail: " <link:mailto:support@example.com>"support@example.com"
p "A reference link: " <link:https://example.com/guide title="The Guide">"see the guide" " and a collapsed one: " <link:https://example.com/guide title="The Guide">"guide" "."
p "A shortcut reference: " <link:https://example.com/guide title="The Guide">"guide" "."
p "An intra-document anchor: " <link:#setup>"jump to setup" "."
p "A relative link: " <link:./CONTRIBUTING.md>"./CONTRIBUTING.md" "."
p "A link whose text is formatted: " <link:https://example.com+bold>"bold" <link:https://example.com>" and " <link:https://example.com+italic>"italic" <link:https://example.com>" and " <link:https://example.com+inlineCode>"code" "."
p "A link with a URL that needs escaping: " <link:https://example.com/a%20b>"spaces" "."
p "A dangerous link is dropped by markdown-it's link validator:" <NL> "[click me](javascript:alert(1)).""
`;

