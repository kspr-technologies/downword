exports[`parseMarkdown: fixtures > 02-single-long-paragraph.md > model 1`] = `
{
  "children": [
    {
      "children": [
        {
          "marks": [],
          "type": "text",
          "value": "Great question — the short answer is that the two approaches differ mainly in where the work happens, and once you frame it that way the trade-offs become a lot clearer: server-side rendering moves the templating step onto a machine you control, which means you get deterministic output, a single place to cache, and no dependency on the visitor's device being fast, whereas client-side rendering pushes that same templating step onto the visitor's browser, which costs you a slower first paint but buys you the ability to re-render arbitrary slices of the page without another round trip, and in practice most teams end up somewhere in the middle because the honest answer is that "it depends on which part of the page you are talking about" — navigation chrome and marketing copy almost never need to be interactive, so they should be rendered once and cached forever, while a live dashboard that updates every few seconds obviously cannot be, and the interesting engineering problem is drawing that boundary in a way your framework can actually express without turning the codebase into two codebases that happen to share a repository.",
        },
      ],
      "type": "paragraph",
    },
  ],
  "metadata": {
    "author": null,
    "custom": {},
    "date": null,
    "description": null,
    "keywords": [],
    "title": null,
  },
  "type": "document",
}
`;

exports[`parseMarkdown: fixtures > 02-single-long-paragraph.md > outline 1`] = `"p "Great question — the short answer is that the two approaches differ mainly in where the work happens, and once you frame it that way the trade-offs become a lot clearer: server-side rendering moves the templating step onto a machine you control, which means you get deterministic output, a single place to cache, and no dependency on the visitor's device being fast, whereas client-side rendering pushes that same templating step onto the visitor's browser, which costs you a slower first paint but buys you the ability to re-render arbitrary slices of the page without another round trip, and in practice most teams end up somewhere in the middle because the honest answer is that \\"it depends on which part of the page you are talking about\\" — navigation chrome and marketing copy almost never need to be interactive, so they should be rendered once and cached forever, while a live dashboard that updates every few seconds obviously cannot be, and the interesting engineering problem is drawing that boundary in a way your framework can actually express without turning the codebase into two codebases that happen to share a repository.""`;

