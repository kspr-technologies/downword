exports[`parseMarkdown: fixtures > 15-inline-code-backticks-and-pipes.md > outline 1`] = `
"p "Use " <inlineCode>"\`" " to open a code span, and " <inlineCode>" " " \` " <inlineCode>" " " when the span itself needs a" <NL> "double backtick."
p "A span containing a pipe: " <inlineCode>"grep 'a|b'" ". A span that is only a pipe: " <inlineCode>"|" "."
p "A span containing backticks: " <inlineCode>"a \` b" ", and one containing three: " <inlineCode>"a \`\` b" "."
p "An empty-ish span: " <inlineCode>" " " (that is a single space)."
p "A span with a newline in the source, " <inlineCode>"which markdown-it folds to a space" ", and a span with " <bold>"no" " emphasis inside: " <inlineCode>"**not bold**" "."
p "Code spans inside other marks: " <bold+inlineCode>"bold code" ", " <italic+inlineCode>"italic code" "," <NL> <strikethrough+inlineCode>"struck code" ", " <link:https://example.com+inlineCode>"linked code" ", and" <NL> <link:https://example.com+bold+inlineCode>"bold linked code" "."
p "Underscores inside code are literal: " <inlineCode>"snake_case_name" ".""
`;

