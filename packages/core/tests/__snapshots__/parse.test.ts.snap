exports[`parseMarkdown: fixtures > 29-llm-readme-output.md > outline 1`] = `
"html "<h1 align=\\"center\\">flux-cache</h1>\\n"
html "<p align=\\"center\\">\\n  <a href=\\"https://github.com/example/flux-cache/actions\\"><img src=\\"https://img.shields.io/github/actions/workflow/status/example/flux-cache/ci.yml?branch=main\\" alt=\\"CI\\"></a>\\n  <a href=\\"https://www.npmjs.com/package/flux-cache\\"><img src=\\"https://img.shields.io/npm/v/flux-cache.svg\\" alt=\\"npm\\"></a>\\n</p>\\n"
quote
  p "A tiny, dependency-free LRU cache with TTL support. " <bold>"~1.2 kB gzipped."
h2 #installation "Installation"
code lang=sh "npm install flux-cache\\n# or\\npnpm add flux-cache\\n# or\\nyarn add flux-cache\\n"
h2 #quick-start "Quick start"
code lang=ts "import { FluxCache } from \\"flux-cache\\";\\n\\nconst cache = new FluxCache<string, User>({ max: 500, ttl: 60_000 });\\n\\ncache.set(\\"u_1\\", { id: \\"u_1\\", name: \\"Ada\\" });\\ncache.get(\\"u_1\\"); // -> { id: \\"u_1\\", name: \\"Ada\\" }\\ncache.get(\\"u_2\\"); // -> undefined\\n"
h2 #api "API"
h3 #new-fluxcacheoptions <inlineCode>"new FluxCache(options)"
table align=[none,none,none,none]
  row header
    cell "Option"
    cell "Type"
    cell "Default"
    cell "Description"
  row
    cell <inlineCode>"max"
    cell <inlineCode>"number"
    cell <inlineCode>"1000"
    cell "Maximum number of entries before eviction"
  row
    cell <inlineCode>"ttl"
    cell <inlineCode>"number | null"
    cell <inlineCode>"null"
    cell "Time-to-live in ms; " <inlineCode>"null" " disables expiry"
  row
    cell <inlineCode>"onEvict"
    cell <inlineCode>"(key, value) => void"
    cell "—"
    cell "Called for every evicted entry"
  row
    cell <inlineCode>"clock"
    cell <inlineCode>"() => number"
    cell <inlineCode>"Date.now"
    cell "Injectable clock, for tests"
h3 #methods "Methods"
list bullet tight
  item
    p <inlineCode>"get(key)" " — returns the value, or " <inlineCode>"undefined" ". " <bold>"Refreshes recency."
  item
    p <inlineCode>"peek(key)" " — same, but " <italic>"does not" " refresh recency."
  item
    p <inlineCode>"set(key, value, ttl?)" " — per-entry " <inlineCode>"ttl" " overrides the constructor's."
  item
    p <inlineCode>"delete(key)" " → " <inlineCode>"boolean"
  item
    p <inlineCode>"clear()"
  item
    p <inlineCode>"size" " (getter) → " <inlineCode>"number"
h2 #benchmarks "Benchmarks"
p "Run on an M2 Pro, Node 22, 1e6 operations:"
table align=[none,right,right]
  row header
    cell "Library"
    cell "ops/sec"
    cell "Relative"
  row
    cell <inlineCode>"flux-cache"
    cell "12,400,000"
    cell <bold>"1.00x"
  row
    cell <inlineCode>"lru-cache"
    cell "9,800,000"
    cell "0.79x"
  row
    cell <inlineCode>"quick-lru"
    cell "11,100,000"
    cell "0.90x"
html "<details>\\n<summary>Full benchmark output</summary>\\n"
code lang=- "flux-cache#get  x 12,412,003 ops/sec ±0.42% (94 runs sampled)\\nlru-cache#get   x  9,801,224 ops/sec ±0.61% (92 runs sampled)\\nquick-lru#get   x 11,102,881 ops/sec ±0.38% (95 runs sampled)\\n"
html "</details>\\n"
h2 #caveats "Caveats"
list ordered start=1 tight
  item
    p "Keys are compared with " <inlineCode>"===" ", so object keys must be identity-stable."
  item
    p "TTL uses a " <italic>"lazy" " sweep — an expired entry still occupies memory until it is" <NL> "read or evicted. If you need eager eviction, pass " <inlineCode>"sweepInterval" "."
  item
    p "Not thread-safe across workers (there are no threads in JS, but there " <italic>"are" <NL> <inlineCode>"SharedArrayBuffer" " users; this is not for them)."
h2 #contributing "Contributing"
p "See " <link:./CONTRIBUTING.md>"CONTRIBUTING.md" ". TL;DR:"
list task tight
  item [x]
    p "Fork and branch from " <inlineCode>"main"
  item [x]
    p <inlineCode>"pnpm install && pnpm test"
  item [ ]
    p "Add a changeset: " <inlineCode>"pnpm changeset"
  item [ ]
    p "Open the PR against " <inlineCode>"main"
h2 #license "License"
p "MIT © " <link:https://example.com>"Example Corp""
`;

