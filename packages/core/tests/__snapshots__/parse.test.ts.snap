exports[`parseMarkdown: fixtures > 16-hard-and-soft-breaks.md > outline 1`] = `
"p "Line one ends with two spaces" <BR> "and line two follows it as a hard break."
p "Line one ends with a backslash" <BR> "and line two follows that as a hard break too."
p "Line one ends with nothing" <NL> "so this is only a soft break."
p "Three trailing spaces" <BR> "is still a hard break."
p "A hard break inside " <bold>"bold" <bold><BR> <bold>"continues here" " and inside " <inlineCode>"code   spans it is literal" "."
list bullet tight
  item
    p "List item with a hard break" <BR> "and its continuation."
quote
  p "Quoted hard break" <BR> "and the next line."
h1 #heading-with-a-hard-break "Heading with a hard break"
p "is not possible, so this is a paragraph.""
`;

