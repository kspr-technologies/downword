exports[`parseMarkdown: fixtures > 09-loose-and-tight-lists.md > outline 1`] = `
"p "Tight list:"
list bullet tight
  item
    p "alpha"
  item
    p "beta"
  item
    p "gamma"
p "Loose list (blank lines between items):"
list bullet loose
  item
    p "alpha"
  item
    p "beta"
  item
    p "gamma"
p "Mixed: only one gap, which makes the whole list loose:"
list bullet loose
  item
    p "alpha"
  item
    p "beta"
  item
    p "gamma"
p "Tight list whose items contain nested tight lists:"
list bullet tight
  item
    p "alpha"
    list bullet tight
      item
        p "alpha one"
      item
        p "alpha two"
  item
    p "beta"
p "Loose outer, tight inner:"
list bullet loose
  item
    p "alpha"
    list bullet tight
      item
        p "alpha one"
      item
        p "alpha two"
  item
    p "beta""
`;

