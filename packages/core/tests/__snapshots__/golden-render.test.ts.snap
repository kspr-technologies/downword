exports[`golden: kitchen sink > reports exactly the expected warnings > warnings 1`] = `
[
  {
    "code": "link-title-dropped",
    "message": "the link title "Example" was not rendered: docx cannot write w:hyperlink/@w:tooltip",
    "severity": "notice",
  },
  {
    "code": "link-unresolved",
    "message": "internal link "#nowhere" does not match any heading; rendered as plain text",
    "severity": "notice",
  },
  {
    "code": "html-inline",
    "message": "inline HTML is not converted: <kbd>",
    "severity": "notice",
  },
  {
    "code": "html-inline",
    "message": "inline HTML is not converted: </kbd>",
    "severity": "notice",
  },
  {
    "code": "code-meta-dropped",
    "message": "the fence metadata "title=\\"demo.ts\\"" has no OOXML equivalent and was not rendered",
    "severity": "notice",
  },
  {
    "code": "image-unresolved",
    "message": "image "missing.png" has no bytes; emitted a placeholder",
    "severity": "error",
  },
  {
    "code": "image-unresolved",
    "message": "image "missing-inline.png" has no bytes; emitted a placeholder",
    "severity": "error",
  },
  {
    "code": "html-block",
    "message": "block-level HTML is not converted: <details>",
    "severity": "notice",
  },
]
`;

