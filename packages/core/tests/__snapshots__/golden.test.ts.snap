</w:rPr>
<w:footnoteRef/>
</w:r>
<w:r>
<w:t xml:space="preserve">Because Word supports them, and LLMs emit them.</w:t>
</w:r>
</w:p>
</w:footnote>
</w:footnotes>
"
`;

