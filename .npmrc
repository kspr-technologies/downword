# Keep caret ranges in package.json so Dependabot/Renovate can do their job.
save-exact=false

# Resolve ranges to the newest matching version (pnpm's default, pinned here so
# a future default change cannot silently alter what a fresh install produces).
resolution-mode=highest

# Deterministic installs in CI (`--frozen-lockfile` is also passed explicitly).
prefer-frozen-lockfile=true

# NOTE: npm provenance is NOT configured here on purpose.
# It is enabled per-publish by CI via `id-token: write` + `npm publish --provenance`
# (see .github/workflows/release.yml and CONTRIBUTING.md). Setting `provenance=true`
# in .npmrc would break local `pnpm pack`/`npm publish` outside of a CI OIDC context.
