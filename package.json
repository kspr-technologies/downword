{
  "name": "downword-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for downword - Markdown to Word (.docx) converter that runs entirely in your browser.",
  "license": "MIT",
  "author": "KSPR Technologies",
  "homepage": "https://github.com/kspr-technologies/downword#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kspr-technologies/downword.git"
  },
  "bugs": {
    "url": "https://github.com/kspr-technologies/downword/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "test:watch": "pnpm -r --parallel --filter \"./packages/*\" test:watch",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "pnpm --filter @ksprtech/downword size",
    "examples": "pnpm -r --filter \"./examples/*\" start",
    "docx:validity": "node scripts/docx-validity.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
